BUN_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Base URL APIAMIS (runtime, hanya untuk /health). Browser memakai VITE_APIAMIS_BASE_URL.
APIAMIS_BASE_URL=http://apiamis.test/api

# Base path publik (build-time untuk Vite, runtime untuk server statis).
# Coolify (subpath): /pengawasan
# Cloudflare subdomain root: /
APP_PUBLIC_BASE_PATH=/pengawasan

# Base URL APIAMIS yang dipanggil langsung dari browser (build-time, wajib).
# Lokal: http://apiamis.test/api · Produksi: https://apiamis.cianjur.space/api
# Browser mengirim cookie `arumanis_token` (credentials: include); APIAMIS harus
# mengizinkan CORS untuk origin dashboard ini.
VITE_APIAMIS_BASE_URL=http://apiamis.test/api

# Portal utama (build-time). Kosongkan = origin yang sama (deploy subpath).
# Produksi subdomain: https://arumanis.cianjur.space
VITE_MAIN_APP_URL=

# Umami visitor analytics (same website as Arumanis utama)
VITE_UMAMI_SCRIPT_URL=https://umami-cvkpzrlvpd23hquu71dt6s05.cianjur.space/script.js
VITE_UMAMI_WEBSITE_ID=cb0064bf-1fd5-4b32-811b-14d8694d135c
VITE_UMAMI_DOMAINS=arumanis.cianjur.space,pengawasan.arumanis.cianjur.space

# Laravel Reverb (build-time — sama dengan REVERB_APP_KEY di apiamis)
# Lokal:
# VITE_REVERB_APP_KEY=arumanis-reverb-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
# Produksi (Coolify build arg):
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=apiamis.cianjur.space
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

